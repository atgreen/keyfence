# Socket activation for KeyFence: the SSH bastion that bridges git over a token.
#
# SPDX-License-Identifier: MIT
#
# The bastion authenticates upstream hosts against
# ~/.keyfence/ssh/known_hosts, so populate that before enabling this:
#
#     ssh-keyscan -H github.com >> ~/.keyfence/ssh/known_hosts
#
# Enabled, this costs nothing until something connects -- systemd holds the
# port, and KeyFence is started on the first connection.  Loopback only: a
# broker that issues credentials has no business listening to the network
# because nobody said otherwise.

[Unit]
Description=KeyFence ssh socket
Documentation=https://github.com/atgreen/keyfence

[Socket]
ListenStream=127.0.0.1:10211
FileDescriptorName=ssh
Service=keyfence.service

[Install]
WantedBy=sockets.target
